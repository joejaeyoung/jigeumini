#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-help}" in
  migrate|preview|apply|status|worker) ;;
  *) echo './scripts/fleet migrate | preview <선정.json> <TTL초> | apply <선정.json> <TTL초> | status | worker <용량> <실행초> <새 결과.json>'; exit 1 ;;
esac
exec ./scripts/lib/run-cli fleet "$@"
