#!/bin/sh
set -eu
source_file=$1
wal_name=$2
printf '%s\n' "$wal_name" | grep -Eq '^([0-9A-F]{24}([.][0-9A-F]{8}[.]backup)?|[0-9A-F]{8}[.]history)$'
target=/pitr/archive/$wal_name
if [ -f "$target" ]; then
    cmp -s "$source_file" "$target"
    exit 0
fi
temporary=/pitr/archive/.$wal_name.tmp
trap 'rm -f "$temporary"' EXIT
cp "$source_file" "$temporary"
cmp -s "$source_file" "$temporary"
sync
mv "$temporary" "$target"
sync
