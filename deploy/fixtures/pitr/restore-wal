#!/bin/sh
set -eu
wal_name=$1
destination=$2
printf '%s\n' "$wal_name" | grep -Eq '^([0-9A-F]{24}([.][0-9A-F]{8}[.]backup)?|[0-9A-F]{8}[.]history)$'
case "$PITR_MODE" in restored|missing|gap) ;; *) exit 2 ;; esac
test -f "/pitr/archive/$wal_name"
cp "/pitr/archive/$wal_name" "$destination"
cmp -s "/pitr/archive/$wal_name" "$destination"
printf '%s\n' "$wal_name" >> "/pitr/used/$PITR_MODE.log"
