#!/usr/bin/env python3
"""단일 수집 실행 전후 API 총합과 collector Kafka ACK를 대조한다."""
import json
from pathlib import Path
import sys
import time
import urllib.request

if len(sys.argv) != 4:
    raise SystemExit('사용법: ./scripts/verify-pipeline <실행전-status.json> <collector.json> <대조결과.json>')
before = json.loads(Path(sys.argv[1]).read_text())
collector = json.loads(Path(sys.argv[2]).read_text())
if collector['verdict'] != 'PASS' or collector.get('delivery', {}).get('mode') != 'KAFKA':
    raise SystemExit('collector의 Kafka 발행 PASS 결과가 필요합니다')
delivery = collector['delivery']
expected = sum(c['chatCount'] for c in collector['channels'])
if expected <= 0 or not delivery['complete'] or delivery['acknowledged'] != expected:
    raise SystemExit('수신/발행 ACK 건수 불일치')
for attempt in range(30):
    with urllib.request.urlopen('http://127.0.0.1:18080/api/status', timeout=5) as response:
        after = json.load(response)
    if any(after['totals'][k] != before['totals'][k] for k in ['projection', 'runId']):
        raise SystemExit('전후 projection/runId가 다릅니다')
    ledger = after['totals']['processedEvents'] - before['totals']['processedEvents']
    buckets = after['totals']['bucketTotal'] - before['totals']['bucketTotal']
    if ledger == buckets == expected:
        break
    time.sleep(1)
else:
    raise SystemExit(f'대조 실패: Kafka={expected}, ledger={ledger}, buckets={buckets}')
result = {'verdict': 'PASS', 'collected': expected, 'kafkaAcknowledged': delivery['acknowledged'],
          'ledgerIncrease': ledger, 'bucketIncrease': buckets, 'before': before, 'after': after,
          'limits': '다른 생산자가 같은 namespace에 쓰지 않는 로컬 단일 수집 실행의 전후 비교. 원천 누락률 검증 아님.'}
output = Path(sys.argv[3])
output.parent.mkdir(parents=True, exist_ok=True)
output.write_text(json.dumps(result, ensure_ascii=False, indent=2) + '\n')
print(f'PASS: 수신 = Kafka ACK = DB 처리 이력 증가 = 집계 증가 = {expected}')
